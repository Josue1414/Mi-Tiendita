{
  "name": "AhorraTiempo-mitienda",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:build": "npm run build && electron .",
    "desktop:open": "electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.33.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.ahorratiempo.mitienda",
    "productName": "Ahorra-Tiempo MI TIENDA",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tu-usuario",
        "repo": "tu-repo"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo mi tienda.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ahorra-Tiempo MI TIENDA"
    }
  }
}
