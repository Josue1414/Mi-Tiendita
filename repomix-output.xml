                    <CreditCard size={16} /> <h3 className="text-xs font-bold">Tarj/Transf.</h3>
                  </div>
                  <p className="text-2xl font-bold text-blue-600 dark:text-blue-400 mt-auto">${metricasTurnoActivo.totalElectronico.toFixed(2)}</p>
