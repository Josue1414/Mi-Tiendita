      tipo: "Bluetooth",
      puerto: "Bluetooth",
      detectado: true,
      mensaje: "Se detectó un entorno móvil. Utiliza la cámara o conecta por Bluetooth."
    };
  }

  return {
    modelo: "Genérico",
    fabricante: "Desconocido",
    driver: "USB HID",
    tipo: "Teclado HID",
    puerto: "USB",
    detectado: false,
    mensaje: "Si usas un escáner USB físico, no requieres configuración. Simplemente escanea."
  };
}
