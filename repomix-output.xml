const obtenerConfiguracionPersistible = (configuracion: Configuracion): Configuracion =>
  Object.fromEntries(
    (Object.keys(CONFIG_INICIAL) as (keyof Configuracion)[]).map((clave) => [
      clave,
      configuracion[clave]
    ])
  ) as Configuracion;

const guardarConfiguracionLocal = async (configuracion: Configuracion) => {
  const configuracionPersistible = obtenerConfiguracionPersistible(configuracion);

  if (esEscritorio) {
    await guardarRegistro("configuracion", {
      ...configuracionPersistible,
      directorioHandle: configuracion.directorioHandle
    });
    return;
  }

  const configuracionWeb = { ...configuracionPersistible };
  delete configuracionWeb.directorioHandle;
  await guardarRegistro("configuracion", configuracionWeb);
};

const sincronizarDiasAlertaNube = async (dias: number) => {
  if (navigator.onLine) {
    const tiendaId = await obtenerTiendaIdActual();
    if (!tiendaId) throw new Error("No se encontró la tienda para sincronizar los días de alerta.");
    const { data, error } = await supabase
      .from("tiendas")
      .update({ dias_alerta_caducidad: dias })
      .eq("id", tiendaId)
      .select("id")
      .maybeSingle();
    if (error) throw error;
    if (!data) throw new Error("No se encontró la tienda para guardar los días de alerta en Supabase.");
    return;
  }

  await registrarPendienteSync({
    tabla: "tiendas",
    operacion: "ACTUALIZAR",
    payload: { dias_alerta_caducidad: dias }
  });
};

export const useEstadoConfiguracion = create<EstadoConfiguracion>((set, get) => ({
  ...CONFIG_INICIAL,
  cargando: true,

  cargarConfiguracion: async () => {
    set({ cargando: true });
    try {
      const sincronizacionNubePermitida = debeSincronizarConNube();
      const tiendaId = sincronizacionNubePermitida ? await obtenerTiendaIdActual() : null;
      const permiteNube = useEstadoPlan.getState().permiteNube;

      if (sincronizacionNubePermitida && navigator.onLine && tiendaId) {
        const { data: tiendaNube, error: errorTiendaNube } = await supabase
          .from('tiendas')
          .select('*')
          .eq('id', tiendaId)
          .single();
        if (errorTiendaNube) throw errorTiendaNube;

        if (tiendaNube) {
          const datosLocales = await obtenerRegistros("configuracion");
          const configLocal = datosLocales[0] as Configuracion | undefined;
          const estadoActualizado: Configuracion = {
            ...CONFIG_INICIAL,
            nombreTienda: tiendaNube.nombre || CONFIG_INICIAL.nombreTienda,
            mensajeTicket: tiendaNube.mensaje_ticket ?? CONFIG_INICIAL.mensajeTicket,
            direccionTienda: tiendaNube.direccion_tienda ?? CONFIG_INICIAL.direccionTienda,
            logoTienda: configLocal?.logoTienda ?? CONFIG_INICIAL.logoTienda,
            directorioImagenes: configLocal?.directorioImagenes ?? CONFIG_INICIAL.directorioImagenes,
            teclaCobro: tiendaNube.tecla_cobro ?? CONFIG_INICIAL.teclaCobro,
            teclaEfectivo: tiendaNube.tecla_efectivo ?? CONFIG_INICIAL.teclaEfectivo,
            teclaTarjeta: tiendaNube.tecla_tarjeta ?? CONFIG_INICIAL.teclaTarjeta,
            teclaTransferencia: tiendaNube.tecla_transferencia ?? CONFIG_INICIAL.teclaTransferencia,
            mensajePago: tiendaNube.mensaje_pago || CONFIG_INICIAL.mensajePago,
            bancoTransferencia: tiendaNube.banco_transferencia || "",
            titularTransferencia: tiendaNube.titular_transferencia || "",
            cuentaTransferencia: tiendaNube.cuenta_transferencia || "",
            diasAlertaCaducidad: Number.isInteger(tiendaNube.dias_alerta_caducidad)
              && tiendaNube.dias_alerta_caducidad >= 1
              && tiendaNube.dias_alerta_caducidad <= 365
              ? tiendaNube.dias_alerta_caducidad
              : configLocal?.diasAlertaCaducidad ?? CONFIG_INICIAL.diasAlertaCaducidad,
            id: CONFIG_ID,
            sincronizacionNube: permiteNube ? configLocal?.sincronizacionNube ?? get().sincronizacionNube : false,
            configuracionNubePendiente: configLocal?.configuracionNubePendiente ?? false
          };

          const preferenciasFiados = leerPreferenciasFiados();
          estadoActualizado.habilitarFiados = preferenciasFiados.habilitarFiados ?? configLocal?.habilitarFiados ?? false;
          estadoActualizado.modoAccesoFiados = preferenciasFiados.modoAccesoFiados ?? configLocal?.modoAccesoFiados ?? "TODOS";

          if (esEscritorio) {
            if (configLocal) {
               estadoActualizado.sincronizacionNube = permiteNube ? configLocal.sincronizacionNube : false;
            }
          }

          if (configLocal?.configuracionNubePendiente) {
            estadoActualizado.nombreTienda = configLocal.nombreTienda;
            estadoActualizado.mensajeTicket = configLocal.mensajeTicket;
            estadoActualizado.direccionTienda = configLocal.direccionTienda;

            if (navigator.onLine) {
              try {
                const { data, error } = await supabase
                  .from("tiendas")
                  .update({
                    nombre: configLocal.nombreTienda,
                    mensaje_ticket: configLocal.mensajeTicket,
                    direccion_tienda: configLocal.direccionTienda
                  })
                  .eq("id", tiendaId)
                  .select("id")
                  .maybeSingle();

                if (error) throw error;
                if (!data) throw new Error("No se encontró la tienda para sincronizar su configuración.");
                estadoActualizado.configuracionNubePendiente = false;
              } catch (error) {
                console.error("No se pudo sincronizar la configuración pendiente con la nube:", error);
              }
            }
          }

          await guardarConfiguracionLocal(estadoActualizado);
          set({ ...estadoActualizado, cargando: false });
          return;
        }
      }

      let estadoLocal = { ...CONFIG_INICIAL };

      const data = await obtenerRegistros("configuracion");
      if (data.length === 0) {
        if (esEscritorio) {
          await guardarRegistro("configuracion", CONFIG_INICIAL);
        }
      } else {
        estadoLocal = { ...CONFIG_INICIAL, ...(data[0] as Configuracion) };
        if (esEscritorio && !permiteNube) {
            estadoLocal.sincronizacionNube = false;
            await guardarRegistro("configuracion", estadoLocal);
        }
      }

      const preferenciasFiados = leerPreferenciasFiados();
      estadoLocal = {
        ...estadoLocal,
        habilitarFiados: preferenciasFiados.habilitarFiados ?? estadoLocal.habilitarFiados,
        modoAccesoFiados: preferenciasFiados.modoAccesoFiados ?? estadoLocal.modoAccesoFiados
      };

      set({ ...estadoLocal, cargando: false });
    } catch (error) {
      console.error("Error al cargar configuracion:", error);
      set({ cargando: false });
    }
  },

  actualizarDatosTienda: async (nombre, mensaje, direccion, logo) => {
    const sincronizaNube = debeSincronizarConNube();
    const nuevaConfig: Configuracion = {
      ...get(),
      nombreTienda: nombre,
      mensajeTicket: mensaje,
      direccionTienda: direccion,
      logoTienda: logo,
      configuracionNubePendiente: sincronizaNube
    };

    try {
      await guardarConfiguracionLocal(nuevaConfig);
      set({
        nombreTienda: nombre, 
        mensajeTicket: mensaje, 
        direccionTienda: direccion, 
        logoTienda: logo,
        configuracionNubePendiente: nuevaConfig.configuracionNubePendiente
      });
    } catch (error) {
      console.error("Error al guardar localmente los datos de la tienda:", error);
      throw error;
    }

    const payloadLAN = { nombreTienda: nombre, mensajeTicket: mensaje, direccionTienda: direccion, logoTienda: logo };
    if (enviarAccionLAN({ tipo: "LAN_CONFIG_TIENDA", payload: payloadLAN })) {
      return { sincronizacionPendiente: false };
    }

    if (!sincronizaNube) return { sincronizacionPendiente: false };

    const payloadNube = { nombre, mensaje_ticket: mensaje, direccion_tienda: direccion };
    if (!navigator.onLine) {
      try {
        await registrarPendienteSync({ tabla: "tiendas", operacion: "ACTUALIZAR", payload: payloadNube });
        return { sincronizacionPendiente: true };
      } catch (error) {
        console.error("La configuración se guardó localmente, pero no se pudo registrar su sincronización pendiente:", error);
        return {
          sincronizacionPendiente: true,
          errorNube: error instanceof Error ? error.message : "No se pudo registrar la sincronización pendiente."
        };
      }
    }

    try {
      const tiendaId = await obtenerTiendaIdActual();
      if (!tiendaId) throw new Error("No se encontró la tienda vinculada para sincronizar.");

      const { data, error } = await supabase
        .from("tiendas")
        .update(payloadNube)
        .eq("id", tiendaId)
        .select("id")
        .maybeSingle();
      if (error) throw error;
      if (!data) throw new Error("No se encontró la tienda para sincronizar su configuración.");

      const configSincronizada = { ...nuevaConfig, configuracionNubePendiente: false };
      await guardarConfiguracionLocal(configSincronizada);
      set({ configuracionNubePendiente: false });
      return { sincronizacionPendiente: false };
    } catch (error) {
      console.error("Los datos se guardaron localmente, pero no se pudieron sincronizar con la nube:", error);
      return {
        sincronizacionPendiente: true,
        errorNube: error instanceof Error ? error.message : "Error desconocido al sincronizar con la nube."
      };
    }
  },
  
  setDirectorioImagenes: async (nombreCarpeta, handle) => {
    try {
      const nuevaConfig = { ...get(), directorioImagenes: nombreCarpeta, directorioHandle: handle };
      await guardarConfiguracionLocal(nuevaConfig);
      set({ directorioImagenes: nombreCarpeta, directorioHandle: handle });
    } catch (error) {
      console.error("Error al guardar el directorio:", error);
    }
  },
  
  toggleSincronizacion: async () => {
    try {
      const permiteNube = useEstadoPlan.getState().permiteNube;
      if (!permiteNube) {
        throw new Error("Tu plan actual no permite la sincronización en la nube.");
      }

      const nuevoEstado = !get().sincronizacionNube;
      if (esEscritorio) {
        const nuevaConfig = { ...get(), sincronizacionNube: nuevoEstado };
        await guardarRegistro("configuracion", nuevaConfig);
      }
      set({ sincronizacionNube: nuevoEstado });
    } catch (error) {
      console.error("Error al cambiar la sincronización:", error);
      throw error; 
    }
  },

  setTeclaCobro: async (tecla) => {
    const teclaNormalizada = tecla.trim() || CONFIG_INICIAL.teclaCobro;
    try {
      await guardarConfiguracionLocal({ ...get(), teclaCobro: teclaNormalizada });
      set({ teclaCobro: teclaNormalizada });
      const payloadLAN = { teclaCobro: teclaNormalizada };
      if (enviarAccionLAN({ tipo: "LAN_CONFIG_TECLA", payload: payloadLAN })) return;

      if (debeSincronizarConNube() && navigator.onLine) {
        const tiendaId = await obtenerTiendaIdActual();
        if (tiendaId) await supabase.from('tiendas').update({ tecla_cobro: teclaNormalizada }).eq('id', tiendaId);
      } else if (debeSincronizarConNube()) {
        await registrarPendienteSync({ tabla: 'tiendas', operacion: 'ACTUALIZAR', payload: { tecla_cobro: teclaNormalizada } });
      }
    } catch (error) {
      console.error("Error al guardar la tecla de cobro:", error);
    }
  },

  actualizarDatosPago: async (datos) => {
    try {
      const configBase = get();
      const nuevaConfig = { ...configBase, ...datos };
      
      await guardarConfiguracionLocal(nuevaConfig);
      set(datos);

      const payloadLAN = {
        mensajePago: nuevaConfig.mensajePago,
        bancoTransferencia: nuevaConfig.bancoTransferencia,
        titularTransferencia: nuevaConfig.titularTransferencia,
        cuentaTransferencia: nuevaConfig.cuentaTransferencia,
        teclaEfectivo: nuevaConfig.teclaEfectivo,
        teclaTarjeta: nuevaConfig.teclaTarjeta,
        teclaTransferencia: nuevaConfig.teclaTransferencia
      };
      const payloadNube = {
        mensaje_pago: payloadLAN.mensajePago,
        banco_transferencia: payloadLAN.bancoTransferencia,
        titular_transferencia: payloadLAN.titularTransferencia,
        cuenta_transferencia: payloadLAN.cuentaTransferencia,
        tecla_efectivo: payloadLAN.teclaEfectivo,
        tecla_tarjeta: payloadLAN.teclaTarjeta,
        tecla_transferencia: payloadLAN.teclaTransferencia
      };

      if (enviarAccionLAN({ tipo: "LAN_CONFIG_PAGO", payload: payloadLAN })) return;

      if (debeSincronizarConNube() && navigator.onLine) {
        const tiendaId = await obtenerTiendaIdActual();
        if (tiendaId) {
          await supabase.from('tiendas').update(payloadNube).eq('id', tiendaId);
        }
      } else if (debeSincronizarConNube()) {
        await registrarPendienteSync({ tabla: 'tiendas', operacion: 'ACTUALIZAR', payload: payloadNube });
      }
    } catch (error) {
      console.error("Error al guardar datos de pago:", error);
    }
  },

  actualizarDatosBascula: async (modelo, puerto, baudRate, formato, unidad) => {
    try {
      const configBase = get();
      const nuevaConfig = {
        ...configBase,
        basculaModelo: modelo,
        basculaPuerto: puerto,
        basculaBaudRate: baudRate,
        basculaFormato: formato,
        basculaUnidad: unidad
      };

      if (esEscritorio) {
        await guardarRegistro("configuracion", { ...nuevaConfig, directorioHandle: configBase.directorioHandle });
      }

      set({
        basculaModelo: modelo,
        basculaPuerto: puerto,
        basculaBaudRate: baudRate,
        basculaFormato: formato,
        basculaUnidad: unidad
      });
    } catch (error) {
      console.error("Error al guardar la configuración de la báscula:", error);
    }
  },

  actualizarDatosEscaner: async (modelo, fabricante, driver, tipo, puerto, detectado, mensaje) => {
    try {
      const configBase = get();
      const nuevaConfig = {
        ...configBase,
        escanerModelo: modelo,
        escanerFabricante: fabricante,
        escanerDriver: driver,
        escanerTipo: tipo,
        escanerPuerto: puerto,
        escanerDetectado: detectado,
        escanerMensaje: mensaje
      };

      if (esEscritorio) {
        await guardarRegistro("configuracion", { ...nuevaConfig, directorioHandle: configBase.directorioHandle });
      }

      set({
        escanerModelo: modelo,
        escanerFabricante: fabricante,
        escanerDriver: driver,
        escanerTipo: tipo,
        escanerPuerto: puerto,
        escanerDetectado: detectado,
        escanerMensaje: mensaje
      });
    } catch (error) {
      console.error("Error al guardar la configuración del escáner:", error);
    }
  },

  setCorreoDueno: async (correo) => {
    const correoLimpio = correo.trim().toLowerCase();
    const configBase = get();
    if (esEscritorio) {
      const nuevaConfig = { ...configBase, correoDueno: correoLimpio };
      await guardarRegistro("configuracion", { ...nuevaConfig, directorioHandle: configBase.directorioHandle });
    }
    set({ correoDueno: correoLimpio });
  },

  // <-- NUEVA FUNCIÓN PARA ACTIVAR/DESACTIVAR FIADOS LOCALMENTE -->
  setHabilitarFiados: async (activo) => {
    try {
      const configBase = get();
      const nuevaConfig = { ...configBase, habilitarFiados: activo };
      guardarPreferenciasFiados({ habilitarFiados: activo, modoAccesoFiados: configBase.modoAccesoFiados });
      set({ habilitarFiados: activo });
      if (esEscritorio) {
        await guardarRegistro("configuracion", { ...nuevaConfig, directorioHandle: configBase.directorioHandle });
      }
    } catch (error) {
      console.error("Error al guardar configuración de fiados:", error);
    }
  },

  setModoAccesoFiados: async (modo) => {
    try {
      const configBase = get();
      const nuevaConfig = { ...configBase, modoAccesoFiados: modo };
      guardarPreferenciasFiados({ habilitarFiados: configBase.habilitarFiados, modoAccesoFiados: modo });
      set({ modoAccesoFiados: modo });
      if (esEscritorio) {
        await guardarRegistro("configuracion", { ...nuevaConfig, directorioHandle: configBase.directorioHandle });
      }
    } catch (error) {
      console.error("Error al guardar el modo de acceso a fiados:", error);
    }
  },

  setDiasAlertaCaducidad: async (dias) => {
    if (!Number.isInteger(dias) || dias < 1 || dias > 365) {
      throw new Error("Los días de alerta deben ser un número entero entre 1 y 365.");
    }
    const configuracionActualizada = { ...get(), diasAlertaCaducidad: dias };
    await guardarConfiguracionLocal(configuracionActualizada);
    set({ diasAlertaCaducidad: dias });
    enviarAccionLAN({
      tipo: "LAN_CONFIG_CADUCIDAD",
      payload: { diasAlertaCaducidad: dias }
    });
    if (debeSincronizarConNube()) {
      await sincronizarDiasAlertaNube(dias);
    }
  },

  aplicarAccionLAN: async (tipo, payload) => {
    const configuracionLAN = (payload || {}) as Partial<Configuracion>;
    let actualizacion: Partial<Configuracion>;
    let payloadNube: Record<string, unknown>;

    if (tipo === "LAN_CONFIG_TIENDA") {
      actualizacion = {
        nombreTienda: configuracionLAN.nombreTienda,
        mensajeTicket: configuracionLAN.mensajeTicket,
        direccionTienda: configuracionLAN.direccionTienda,
        logoTienda: configuracionLAN.logoTienda
      };
      payloadNube = {
        nombre: actualizacion.nombreTienda,
        mensaje_ticket: actualizacion.mensajeTicket,
        direccion_tienda: actualizacion.direccionTienda
      };
    } else if (tipo === "LAN_CONFIG_PAGO") {
      actualizacion = {
        mensajePago: configuracionLAN.mensajePago,
        bancoTransferencia: configuracionLAN.bancoTransferencia,
        titularTransferencia: configuracionLAN.titularTransferencia,
        cuentaTransferencia: configuracionLAN.cuentaTransferencia,
        teclaEfectivo: configuracionLAN.teclaEfectivo,
        teclaTarjeta: configuracionLAN.teclaTarjeta,
        teclaTransferencia: configuracionLAN.teclaTransferencia
      };
      payloadNube = {
        mensaje_pago: actualizacion.mensajePago,
        banco_transferencia: actualizacion.bancoTransferencia,
        titular_transferencia: actualizacion.titularTransferencia,
        cuenta_transferencia: actualizacion.cuentaTransferencia,
        tecla_efectivo: actualizacion.teclaEfectivo,
        tecla_tarjeta: actualizacion.teclaTarjeta,
        tecla_transferencia: actualizacion.teclaTransferencia
      };
    } else if (tipo === "LAN_CONFIG_TECLA") {
      actualizacion = { teclaCobro: configuracionLAN.teclaCobro };
      payloadNube = { tecla_cobro: actualizacion.teclaCobro };
    } else if (tipo === "LAN_CONFIG_CADUCIDAD") {
      const dias = configuracionLAN.diasAlertaCaducidad;
      if (typeof dias !== "number" || !Number.isInteger(dias) || dias < 1 || dias > 365) return;
      const configuracionActualizada = { ...get(), diasAlertaCaducidad: dias };
      await guardarConfiguracionLocal(configuracionActualizada);
      set({ diasAlertaCaducidad: dias });
      if (useEstadoRed.getState().esMaestro) {
        enviarAccionLAN({ tipo: "LAN_CONFIG_CADUCIDAD", payload: { diasAlertaCaducidad: dias } });
      }
      if (debeSincronizarConNube()) {
        await sincronizarDiasAlertaNube(dias);
      }
      return;
    } else {
      return;
    }

    const nuevaConfiguracion = { ...get(), ...actualizacion };
    await guardarConfiguracionLocal(nuevaConfiguracion);
    set(actualizacion);

    if (debeSincronizarConNube() && navigator.onLine) {
      const tiendaId = await obtenerTiendaIdActual();
      if (tiendaId) await supabase.from("tiendas").update(payloadNube).eq("id", tiendaId);
    } else if (debeSincronizarConNube()) {
      await registrarPendienteSync({ tabla: "tiendas", operacion: "ACTUALIZAR", payload: payloadNube });
    }
  },

  hidratarEstadoLAN: async (snapshot) => {
    const clavesCompartidas: (keyof Configuracion)[] = [
      "nombreTienda",
      "mensajeTicket",
      "direccionTienda",
      "logoTienda",
      "teclaCobro",
      "teclaEfectivo",
      "teclaTarjeta",
      "teclaTransferencia",
      "bancoTransferencia",
      "titularTransferencia",
      "cuentaTransferencia",
      "mensajePago",
      "diasAlertaCaducidad"
    ];
    const actualizacion: Partial<Configuracion> = {};
    for (const clave of clavesCompartidas) {
      const valor = snapshot.configuracion[clave];
      if (valor !== undefined) Object.assign(actualizacion, { [clave]: valor });
    }

    const configuracionActualizada = { ...get(), ...actualizacion };
    await guardarConfiguracionLocal(configuracionActualizada);
    set({ ...actualizacion, cargando: false });
  },

  sincronizarConfiguracion: async (payload: any) => {
    const { new: nuevo } = payload;
    if (nuevo) {
      const actualizacion: Partial<Configuracion> = {
        nombreTienda: nuevo.nombre,
        mensajeTicket: nuevo.mensaje_ticket ?? get().mensajeTicket,
        direccionTienda: nuevo.direccion_tienda ?? get().direccionTienda,
        teclaCobro: nuevo.tecla_cobro || get().teclaCobro,
        teclaEfectivo: nuevo.tecla_efectivo || get().teclaEfectivo,
        teclaTarjeta: nuevo.tecla_tarjeta || get().teclaTarjeta,
        teclaTransferencia: nuevo.tecla_transferencia || get().teclaTransferencia,
        mensajePago: nuevo.mensaje_pago,
        bancoTransferencia: nuevo.banco_transferencia || "",
        titularTransferencia: nuevo.titular_transferencia || "",
        cuentaTransferencia: nuevo.cuenta_transferencia || ""
      };
      if (Number.isInteger(nuevo.dias_alerta_caducidad) && nuevo.dias_alerta_caducidad >= 1 && nuevo.dias_alerta_caducidad <= 365) {
        actualizacion.diasAlertaCaducidad = nuevo.dias_alerta_caducidad;
      }
      
      set((state) => ({ ...state, ...actualizacion }));
      
      if (esEscritorio) {
        const configBase = get();
        await guardarRegistro("configuracion", { 
          ...configBase, 
          ...actualizacion, 
          directorioHandle: configBase.directorioHandle 
        });
      }
      if (actualizacion.diasAlertaCaducidad !== undefined) {
        await guardarConfiguracionLocal({ ...get(), diasAlertaCaducidad: actualizacion.diasAlertaCaducidad });
        enviarAccionLAN({
          tipo: "LAN_CONFIG_CADUCIDAD",
          payload: { diasAlertaCaducidad: actualizacion.diasAlertaCaducidad }
        });
      }

      enviarAccionLAN({
        tipo: "LAN_CONFIG_TIENDA",
        payload: {
          nombreTienda: actualizacion.nombreTienda,
          mensajeTicket: actualizacion.mensajeTicket,
          direccionTienda: actualizacion.direccionTienda,
          logoTienda: get().logoTienda
        }
      });
      enviarAccionLAN({
        tipo: "LAN_CONFIG_TECLA",
        payload: { teclaCobro: actualizacion.teclaCobro }
      });
      enviarAccionLAN({
        tipo: "LAN_CONFIG_PAGO",
        payload: {
          mensajePago: actualizacion.mensajePago,
          bancoTransferencia: actualizacion.bancoTransferencia,
          titularTransferencia: actualizacion.titularTransferencia,
          cuentaTransferencia: actualizacion.cuentaTransferencia,
          teclaEfectivo: actualizacion.teclaEfectivo,
          teclaTarjeta: actualizacion.teclaTarjeta,
          teclaTransferencia: actualizacion.teclaTransferencia
        }
      });
      if (actualizacion.diasAlertaCaducidad !== undefined) {
        await guardarConfiguracionLocal({ ...get(), ...actualizacion });
        enviarAccionLAN({
          tipo: "LAN_CONFIG_CADUCIDAD",
          payload: { diasAlertaCaducidad: actualizacion.diasAlertaCaducidad }
        });
      }
    }
  }
}));
</file>

<file path="src/estado/estadoInventario.ts">
// src/estado/estadoInventario.ts
import { create } from "zustand";
import type { Categoria, Producto } from "../tipos/producto";
import { guardarRegistro, obtenerRegistros, eliminarRegistro, registrarPendienteSync } from "../servicios/db";
import { CATEGORIAS_INICIALES, siguienteColor } from "../utilidades/coloresCategoria";
import { supabase, obtenerTiendaIdActual } from "../servicios/supabase";
import { debeSincronizarConNube, enviarAccionLAN } from "../servicios/sincronizacionLAN";
import { descontarDeLotes } from "../utilidades/lotes";
import { crearIdentificadorUnico } from "../utilidades/identificador";

const esEscritorio = typeof window !== 'undefined' && (window as any).apiLocal !== undefined;

interface EstadoInventario {
  productos: Producto[];
  categorias: Categoria[];
  cargando: boolean;
  cargarProductos: () => Promise<void>;
  agregarProducto: (producto: Producto, propagado?: boolean) => Promise<void>;
  actualizarProducto: (producto: Producto, propagado?: boolean) => Promise<void>;
  eliminarProducto: (id: string, propagado?: boolean) => Promise<void>;
  agregarCategoria: (nombre: string, color?: string, propagado?: boolean, id?: string) => Promise<Categoria | null>;
  eliminarCategoria: (id: string, propagado?: boolean) => Promise<void>;
  descontarStock: (items: Array<{ producto_id: string; cantidad: number }>, propagado?: boolean) => Promise<void>;
  aplicarSincronizacionRemota: (accion: any) => void;
  hidratarEstadoLAN: (snapshot: { productos: Producto[]; categorias: Categoria[] }) => Promise<void>;
  sincronizarProducto: (payload: any) => Promise<void>; 
  sincronizarCategoria: (payload: any) => Promise<void>; 
}

const mapearProductoASupabase = (p: Producto, tiendaId: string) => ({
  id: p.id,
  tienda_id: tiendaId,
  barcode: p.codigo_barras,
  nombre: p.nombre,
  descripcion: p.descripcion || null,
  ubicacion: p.ubicacion || null,
  paquete: p.paquete || null,
  unidad: p.unidad,
  stock_actual: p.stock_actual,
  stock_minimo: p.stock_minimo,
  controla_stock: p.controla_stock,
  precio: p.precio,
  costo: p.costo,
  descuento_porcentaje: p.descuento_porcentaje,
  activo: p.activo,
  requiere_autorizacion: p.requiere_autorizacion,
  mensaje_autorizacion: p.mensaje_autorizacion || null,
  permite_foto_autorizacion: p.permite_foto_autorizacion,
  lotes: p.lotes ?? [],
  nombre_archivo_local: p.imagen_archivo || null
});

const sincronizarConCola = async (
  tabla: string,
  operacion: "AGREGAR" | "ACTUALIZAR" | "ELIMINAR",
  payload: unknown,
  enviar: () => PromiseLike<{ error: unknown | null }>
) => {
  try {
    const { error } = await enviar();
    if (error) throw error;
  } catch (error) {
    console.error(`No se pudo sincronizar ${tabla} con Supabase; se guardará para reintentar:`, error);
    await registrarPendienteSync({ tabla, operacion, payload });
  }
};

const mapearProductoDesdeSupabase = (p: any, categoriaNombre: string = ""): Producto => ({
  id: p.id,
  codigo_barras: p.barcode,
  nombre: p.nombre,
  descripcion: p.descripcion || "",
  ubicacion: p.ubicacion || "",
  paquete: p.paquete || "",
  categoria: categoriaNombre, 
  unidad: p.unidad,
  stock_actual: Number(p.stock_actual),
  stock_minimo: Number(p.stock_minimo),
  controla_stock: p.controla_stock,
  precio: Number(p.precio),
  costo: Number(p.costo),
  descuento_porcentaje: Number(p.descuento_porcentaje),
  activo: p.activo,
  requiere_autorizacion: p.requiere_autorizacion,
  mensaje_autorizacion: p.mensaje_autorizacion || "",
  permite_foto_autorizacion: p.permite_foto_autorizacion,
  lotes: Array.isArray(p.lotes) ? p.lotes : [],
  imagen_archivo: typeof p.nombre_archivo_local === "string" && !p.nombre_archivo_local.startsWith("data:image/")
    ? p.nombre_archivo_local
    : undefined
});

export const useEstadoInventario = create<EstadoInventario>((set, get) => ({
  productos: [],
  categorias: [],
  cargando: true,

  aplicarSincronizacionRemota: (accion) => {
    const { tipo, payload } = accion;
    switch (tipo) {
      case 'AGREGAR_PRODUCTO': get().agregarProducto(payload, true); break;
      case 'ACTUALIZAR_PRODUCTO': get().actualizarProducto(payload, true); break;
      case 'ELIMINAR_PRODUCTO': get().eliminarProducto(payload, true); break;
      case 'DESCONTAR_STOCK': get().descontarStock(payload, true); break;
      case 'AGREGAR_CATEGORIA': get().agregarCategoria(payload.nombre, payload.color, true, payload.id); break;
      case 'ACTUALIZAR_CATEGORIA': get().agregarCategoria(payload.nombre, payload.color, true, payload.id); break;
      case 'ELIMINAR_CATEGORIA': get().eliminarCategoria(payload, true); break;
    }
  },

  hidratarEstadoLAN: async ({ productos, categorias }) => {
    const productosLocales = await obtenerRegistros("productos");
    const categoriasLocales = await obtenerRegistros("categorias");
    const idsProductos = new Set(productos.map((producto) => producto.id));
    const idsCategorias = new Set(categorias.map((categoria) => categoria.id));
    for (const producto of productosLocales as Producto[]) {
      if (!idsProductos.has(producto.id)) await eliminarRegistro("productos", producto.id);
    }
    for (const categoria of categoriasLocales as Categoria[]) {
      if (!idsCategorias.has(categoria.id)) await eliminarRegistro("categorias", categoria.id);
    }
    for (const categoria of categorias) await guardarRegistro("categorias", categoria);
    for (const producto of productos) await guardarRegistro("productos", producto);
    set({ productos, categorias, cargando: false });
  },

  cargarProductos: async () => {
    set({ cargando: true });
    try {
      let productosEstado: Producto[] = [];
      let categoriasEstado: Categoria[] = [];

      const tiendaId = await obtenerTiendaIdActual();

      if (navigator.onLine && debeSincronizarConNube() && tiendaId) {
        const { data: catSupabase } = await supabase.from('categorias').select('*').eq('tienda_id', tiendaId);
        const { data: prodSupabase } = await supabase.from('productos').select('*').eq('tienda_id', tiendaId);

        if (catSupabase && prodSupabase) {
          if (prodSupabase.some((producto) =>
            typeof producto.nombre_archivo_local === "string" && producto.nombre_archivo_local.startsWith("data:image/")
          )) {
            const { error } = await supabase
              .from("productos")
              .update({ nombre_archivo_local: null })
              .eq("tienda_id", tiendaId)
              .like("nombre_archivo_local", "data:image/%");
            if (error) console.error("No se pudieron limpiar las imágenes antiguas de Supabase:", error);
          }

          const categoriasNube = catSupabase.map(c => ({ id: c.id, nombre: c.nombre, color: c.color }));
          const productosLocales = await obtenerRegistros("productos") as Producto[];
          const productosLocalesPorId = new Map(productosLocales.map((producto) => [producto.id, producto]));
          const productosNube = prodSupabase.map(p => {
            const catAsociada = categoriasNube.find(c => c.id === p.categoria_id);
            const productoNube = mapearProductoDesdeSupabase(p, catAsociada?.nombre || "");
            const productoLocal = productosLocalesPorId.get(productoNube.id);
            return {
              ...productoNube,
              imagen_url: productoLocal?.imagen_url,
              imagen_archivo: productoNube.imagen_archivo || productoLocal?.imagen_archivo
            };
          });

          if (esEscritorio) {
            const idsCategoriasNube = new Set(categoriasNube.map(c => c.id));
            const idsProductosNube = new Set(productosNube.map(p => p.id));

            const categoriasLocal = await obtenerRegistros("categorias");

            for (const catLocal of categoriasLocal) {
              if (!idsCategoriasNube.has(catLocal.id)) await eliminarRegistro("categorias", catLocal.id);
            }
            for (const prodLocal of productosLocales) {
              if (!idsProductosNube.has(prodLocal.id)) await eliminarRegistro("productos", prodLocal.id);
            }

            for (const cat of categoriasNube) await guardarRegistro("categorias", cat);
            for (const prod of productosNube) await guardarRegistro("productos", prod);
          }

          set({ productos: productosNube, categorias: categoriasNube, cargando: false });
          return;
        }
      }

      if (esEscritorio) {
        const dataLocal = await obtenerRegistros("productos");
        productosEstado = (dataLocal as Producto[]).map((p) => ({
          ...p,
          descuento_porcentaje: p.descuento_porcentaje ?? 0,
          lotes: Array.isArray(p.lotes) ? p.lotes : [],
        }));
        categoriasEstado = (await obtenerRegistros("categorias")) as Categoria[];

        if (categoriasEstado.length === 0) {
          categoriasEstado = CATEGORIAS_INICIALES.map((c) => ({ id: crearIdentificadorUnico(), nombre: c.nombre, color: c.color }));
          for (const cat of categoriasEstado) await guardarRegistro("categorias", cat);
        }
        set({ productos: productosEstado, categorias: categoriasEstado, cargando: false });
      } else if (!navigator.onLine) {
        set({ cargando: false });
      } else {
        set({ cargando: false });
      }
    } catch (error) {
      set({ cargando: false });
    }
  },

  agregarProducto: async (producto, propagado = false) => {
    if (!propagado && enviarAccionLAN({ tipo: 'AGREGAR_PRODUCTO', payload: producto })) {
      await guardarRegistro("productos", producto);
      set((estado) => ({ productos: [...estado.productos, producto] })); 
      return;
    }

    await guardarRegistro("productos", producto);
    set((estado) => ({ productos: estado.productos.some(p => p.id === producto.id) ? estado.productos : [...estado.productos, producto] }));
    
    if (navigator.onLine && debeSincronizarConNube()) {
      const tiendaId = await obtenerTiendaIdActual();
      if (tiendaId) {
        const payload = mapearProductoASupabase(producto, tiendaId);
        const cat = get().categorias.find(c => c.nombre === producto.categoria);
        if (cat) (payload as any).categoria_id = cat.id;
        await sincronizarConCola("productos", "AGREGAR", producto, () => supabase.from("productos").upsert(payload));
      } else await registrarPendienteSync({ tabla: "productos", operacion: "AGREGAR", payload: producto });
    } else if (!navigator.onLine && debeSincronizarConNube()) {
      await registrarPendienteSync({ tabla: 'productos', operacion: 'AGREGAR', payload: producto });
    }
  },

  actualizarProducto: async (productoActualizado, propagado = false) => {
    if (!propagado && enviarAccionLAN({ tipo: 'ACTUALIZAR_PRODUCTO', payload: productoActualizado })) {
      await guardarRegistro("productos", productoActualizado);
      set((estado) => ({ productos: estado.productos.map((p) => (p.id === productoActualizado.id ? productoActualizado : p)) }));
      return;
    }

    await guardarRegistro("productos", productoActualizado);
    set((estado) => ({ productos: estado.productos.map((p) => (p.id === productoActualizado.id ? productoActualizado : p)) }));

    if (navigator.onLine && debeSincronizarConNube()) {
      const tiendaId = await obtenerTiendaIdActual();
      if (tiendaId) {
        const payload = mapearProductoASupabase(productoActualizado, tiendaId);
        const cat = get().categorias.find(c => c.nombre === productoActualizado.categoria);
        if (cat) (payload as any).categoria_id = cat.id;
        await sincronizarConCola("productos", "ACTUALIZAR", productoActualizado, () => supabase.from("productos").upsert(payload));
      } else await registrarPendienteSync({ tabla: "productos", operacion: "ACTUALIZAR", payload: productoActualizado });
    } else if (!navigator.onLine && debeSincronizarConNube()) {
      await registrarPendienteSync({ tabla: 'productos', operacion: 'ACTUALIZAR', payload: productoActualizado });
    }
  },

  eliminarProducto: async (id, propagado = false) => {
    if (!propagado && enviarAccionLAN({ tipo: 'ELIMINAR_PRODUCTO', payload: id })) {
      await eliminarRegistro("productos", id);
      set((estado) => ({ productos: estado.productos.filter((p) => p.id !== id) }));
      return;
    }

    await eliminarRegistro("productos", id);
    set((estado) => ({ productos: estado.productos.filter((p) => p.id !== id) }));

    if (navigator.onLine && debeSincronizarConNube()) {
      const tiendaId = await obtenerTiendaIdActual();
      if (tiendaId) {
        await sincronizarConCola("productos", "ELIMINAR", id, () => supabase.from("productos").delete().eq("id", id).eq("tienda_id", tiendaId));
      } else await registrarPendienteSync({ tabla: "productos", operacion: "ELIMINAR", payload: id });
    } else if (!navigator.onLine && debeSincronizarConNube()) {
      await registrarPendienteSync({ tabla: 'productos', operacion: 'ELIMINAR', payload: id });
    }
  },

  agregarCategoria: async (nombre, color, propagado = false, id) => {
    const nombreLimpio = nombre.trim();
    if (!nombreLimpio) return null;

    const existentePorId = id ? get().categorias.find((categoria) => categoria.id === id) : undefined;
    if (existentePorId) {
      const actualizada = { ...existentePorId, nombre: nombreLimpio, color: color || existentePorId.color };
      await guardarRegistro("categorias", actualizada);
      set((estado) => ({
        categorias: estado.categorias.map((categoria) => categoria.id === id ? actualizada : categoria),
        productos: estado.productos.map((producto) => producto.categoria === existentePorId.nombre
          ? { ...producto, categoria: nombreLimpio }
          : producto)
      }));
      if (navigator.onLine && debeSincronizarConNube()) {
        const tiendaId = await obtenerTiendaIdActual();
        if (tiendaId) {
          await sincronizarConCola("categorias", "ACTUALIZAR", actualizada, () => supabase.from('categorias').upsert({
            id: actualizada.id,
            tienda_id: tiendaId,
            nombre: actualizada.nombre,
            color: actualizada.color
          }));
        } else await registrarPendienteSync({ tabla: "categorias", operacion: "ACTUALIZAR", payload: actualizada });
      } else if (!navigator.onLine && debeSincronizarConNube()) {
        await registrarPendienteSync({ tabla: 'categorias', operacion: 'ACTUALIZAR', payload: actualizada });
      }
      return actualizada;
    }
    
    const existente = get().categorias.find((c) => c.nombre.toLowerCase() === nombreLimpio.toLowerCase());
    if (existente) return existente;

    const nueva: Categoria = { 
      id: id || crearIdentificadorUnico(),
      nombre: nombreLimpio, 
      color: color || siguienteColor(get().categorias.map((c) => c.color)) 
    };

    if (!propagado && enviarAccionLAN({ tipo: 'AGREGAR_CATEGORIA', payload: nueva })) {
      await guardarRegistro("categorias", nueva);
      set((estado) => ({ categorias: [...estado.categorias, nueva] }));
      return nueva;
    }

    await guardarRegistro("categorias", nueva);
    set((estado) => ({ categorias: [...estado.categorias, nueva] }));

    if (navigator.onLine && debeSincronizarConNube()) {
      const tiendaId = await obtenerTiendaIdActual();
      if (tiendaId) {
        await sincronizarConCola("categorias", "AGREGAR", nueva, () => supabase.from('categorias').upsert({ id: nueva.id, tienda_id: tiendaId, nombre: nueva.nombre, color: nueva.color }));
      } else await registrarPendienteSync({ tabla: "categorias", operacion: "AGREGAR", payload: nueva });
    } else if (!navigator.onLine && debeSincronizarConNube()) {
      await registrarPendienteSync({ tabla: 'categorias', operacion: 'AGREGAR', payload: nueva });
    }
    return nueva;
  },

  eliminarCategoria: async (id, propagado = false) => {
    const categoria = get().categorias.find((c) => c.id === id);
    if (!categoria) return;

    if (!propagado && enviarAccionLAN({ tipo: 'ELIMINAR_CATEGORIA', payload: id })) {
      const productosActualizados = get().productos.map((producto) =>
        producto.categoria.trim().toLocaleLowerCase() === categoria.nombre.trim().toLocaleLowerCase() ? { ...producto, categoria: "" } : producto
      );
      for (const producto of productosActualizados) {
        const productoAnterior = get().productos.find((p) => p.id === producto.id);
        if (productoAnterior?.categoria !== producto.categoria) await guardarRegistro("productos", producto);
      }
      await eliminarRegistro("categorias", id);
      set((estado) => ({ productos: productosActualizados, categorias: estado.categorias.filter((c) => c.id !== id) }));
      return;
    }

    const productosActualizados = get().productos.map((producto) => 
      producto.categoria.trim().toLocaleLowerCase() === categoria.nombre.trim().toLocaleLowerCase() ? { ...producto, categoria: "" } : producto
    );
    
    for (const producto of productosActualizados) {
      const productoAnterior = get().productos.find((p) => p.id === producto.id);
      if (productoAnterior?.categoria !== producto.categoria) {
        await get().actualizarProducto(producto, true); 
      }
    }
    
    await eliminarRegistro("categorias", id);
    set((estado) => ({ productos: productosActualizados, categorias: estado.categorias.filter((c) => c.id !== id) }));

    if (navigator.onLine && debeSincronizarConNube()) {
      const tiendaId = await obtenerTiendaIdActual();
      if (tiendaId) {
        await sincronizarConCola("categorias", "ELIMINAR", id, () => supabase.from('categorias').delete().eq('id', id).eq('tienda_id', tiendaId));
      } else await registrarPendienteSync({ tabla: "categorias", operacion: "ELIMINAR", payload: id });
    } else if (!navigator.onLine && debeSincronizarConNube()) {
      await registrarPendienteSync({ tabla: 'categorias', operacion: 'ELIMINAR', payload: id });
    }
  },

  descontarStock: async (items, propagado = false) => {
    const cantidadesPorProducto = new Map<string, number>();
    for (const item of items) {
      cantidadesPorProducto.set(
        item.producto_id,
        (cantidadesPorProducto.get(item.producto_id) ?? 0) + Math.max(0, item.cantidad),
      );
    }

    if (!propagado && enviarAccionLAN({ tipo: 'DESCONTAR_STOCK', payload: items })) {
      const productosActualizados = get().productos.map((producto) => {
        const cantidadSolicitada = cantidadesPorProducto.get(producto.id);
        if (cantidadSolicitada === undefined || !producto.controla_stock) return producto;
        const cantidadDescontada = Math.min(Math.max(0, producto.stock_actual), cantidadSolicitada);
        return {
          ...producto,
          stock_actual: Math.max(0, producto.stock_actual - cantidadDescontada),
          lotes: descontarDeLotes(producto.lotes, cantidadDescontada),
        };
      });
      for (const producto of productosActualizados) {
        const anterior = get().productos.find((actual) => actual.id === producto.id);
        if (anterior?.stock_actual !== producto.stock_actual) await guardarRegistro("productos", producto);
      }
      set({ productos: productosActualizados });
      return;
    }

    const productosActualizados = get().productos.map((producto) => {
      const cantidadSolicitada = cantidadesPorProducto.get(producto.id);
      if (cantidadSolicitada === undefined || !producto.controla_stock) return producto;
      const cantidadDescontada = Math.min(Math.max(0, producto.stock_actual), cantidadSolicitada);
      return {
        ...producto,
        stock_actual: Math.max(0, producto.stock_actual - cantidadDescontada),
        lotes: descontarDeLotes(producto.lotes, cantidadDescontada),
      };
    });

    for (const producto of productosActualizados) {
      const productoAnterior = get().productos.find((p) => p.id === producto.id);
      if (productoAnterior?.stock_actual !== producto.stock_actual) {
        await get().actualizarProducto(producto, true);
      }
    }
    set({ productos: productosActualizados });

  },

  // Sincronizaciones silenciosas desde la nube
  sincronizarProducto: async (payload: any) => {
    const { eventType, new: nuevo, old: viejo } = payload;
    const { productos, categorias } = get();

    if (eventType === 'DELETE') {
      if (esEscritorio) await eliminarRegistro("productos", viejo.id);
      set({ productos: productos.filter((p) => p.id !== viejo.id) });
      enviarAccionLAN({ tipo: 'ELIMINAR_PRODUCTO', payload: viejo.id });
    } else {
      const catAsociada = categorias.find((c) => c.id === nuevo.categoria_id);
      const prodMapeado = mapearProductoDesdeSupabase(nuevo, catAsociada?.nombre || "");

      if (esEscritorio) await guardarRegistro("productos", prodMapeado);

      if (eventType === 'INSERT') {
        if (!productos.some(p => p.id === prodMapeado.id)) {
          set({ productos: [...productos, prodMapeado] });
        }
      } else if (eventType === 'UPDATE') {
        set({ productos: productos.map((p) => (p.id === prodMapeado.id ? prodMapeado : p)) });
      }
      enviarAccionLAN({
        tipo: eventType === 'INSERT' ? 'AGREGAR_PRODUCTO' : 'ACTUALIZAR_PRODUCTO',
        payload: prodMapeado
      });
    }
  },

  sincronizarCategoria: async (payload: any) => {
    const { eventType, new: nuevo, old: viejo } = payload;
    const { categorias, productos } = get();

    if (eventType === 'DELETE') {
      if (esEscritorio) await eliminarRegistro("categorias", viejo.id);
      
      const productosActualizados = productos.map((p) => {
        const cat = categorias.find(c => c.id === viejo.id);
        if (cat && p.categoria.trim().toLowerCase() === cat.nombre.trim().toLowerCase()) {
          return { ...p, categoria: "" };
        }
        return p;
      });
      
      for (const p of productosActualizados) {
         const pAnterior = productos.find(x => x.id === p.id);
         if (pAnterior?.categoria !== p.categoria) {
            await get().actualizarProducto(p, true); 
         }
      }

      set({ categorias: categorias.filter((c) => c.id !== viejo.id), productos: productosActualizados });
      enviarAccionLAN({ tipo: 'ELIMINAR_CATEGORIA', payload: viejo.id });
    } else {
      const catMapeada: Categoria = { id: nuevo.id, nombre: nuevo.nombre, color: nuevo.color };
      if (esEscritorio) await guardarRegistro("categorias", catMapeada);

      if (eventType === 'INSERT') {
        if (!categorias.some(c => c.id === catMapeada.id)) {
          set({ categorias: [...categorias, catMapeada] });
        }
      } else if (eventType === 'UPDATE') {
        const oldCat = categorias.find(c => c.id === catMapeada.id);
        let nuevosProductos = productos;
        if (oldCat && oldCat.nombre !== catMapeada.nombre) {
          nuevosProductos = productos.map((p) => p.categoria === oldCat.nombre ? { ...p, categoria: catMapeada.nombre } : p);
          for (const p of nuevosProductos) {
             const pAnterior = productos.find(x => x.id === p.id);
             if (pAnterior?.categoria !== p.categoria) {
                await get().actualizarProducto(p, true); 
             }
          }
        }
        set({ 
          categorias: categorias.map((c) => c.id === catMapeada.id ? catMapeada : c),
          productos: nuevosProductos
        });
      }
      enviarAccionLAN({
        tipo: eventType === 'INSERT' ? 'AGREGAR_CATEGORIA' : 'ACTUALIZAR_CATEGORIA',
        payload: catMapeada
      });
    }
  }
}));
</file>

