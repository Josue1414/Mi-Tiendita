    if (impresoras.length > 0) {
      setFormImpresora(prev => ({ ...prev, modelo: impresoras[0].modelo, fabricante: impresoras[0].fabricante, puerto: impresoras[0].puerto, tamanio: impresoras[0].tamanio }));
