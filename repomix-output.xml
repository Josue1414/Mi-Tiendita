                productosFiltrados.map((producto) => {
                  const esCritico = producto.stock_actual === 0;
                  return (
                    <tr key={producto.id} className="hover:bg-slate-50/50 dark:hover:bg-slate-800/50 transition-colors text-slate-900 dark:text-slate-100">
