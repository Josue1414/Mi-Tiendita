@import "tailwindcss";

/* Fuerza a Tailwind a activar el modo oscuro cuando la clase .dark está presente en el HTML */
@variant dark (&:where(.dark, .dark *));

@theme {
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-card: var(--card);
  --color-muted: var(--muted);
}

@layer base {
  :root {
    --background: #f8fafc;
    --foreground: #0f172a;
    --primary: #042f2e;
    --primary-foreground: #f8fafc;
    --card: #ffffff;
